# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys and never paste them into chat.

# --- Supabase (public values, safe in the browser; not used by the code yet) ---
# Find both in your Supabase project under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# --- Gemini (server only: never add a NEXT_PUBLIC_ prefix) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional. A model ID from https://ai.google.dev/gemini-api/docs/models
# If this is left out, the code uses the default set in lib/stylist/generate.ts.
GEMINI_MODEL=
