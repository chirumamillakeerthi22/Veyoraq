# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys and never paste them into chat.

# --- Supabase (public values, safe in the browser) ---
# Find both in your Supabase project under Project Settings > API.
# Use the PUBLISHABLE key here. Never put a secret key in a NEXT_PUBLIC_ variable;
# the app refuses to start Supabase if it finds one.
# Check the connection at /api/health/supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# --- Gemini (server only: never add a NEXT_PUBLIC_ prefix) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional. A model ID from https://ai.google.dev/gemini-api/docs/models
# If this is left out, the code uses the default set in lib/stylist/generate.ts.
GEMINI_MODEL=

# Optional. Turns on AI image generation (FIX My Style's "Your Styled Look" and the
# quiz's "Create image"). Leave it empty to keep image generation OFF.
# IMPORTANT: image models are separate from the text model above, are NOT part of
# Google's free tier, and are billed per image. Enable billing on the Google AI
# project first, then check the current price at
# https://ai.google.dev/gemini-api/docs/pricing and choose a model from
# https://ai.google.dev/gemini-api/docs/image-generation (for example
# gemini-2.5-flash-image). Without billing, requests fail with a quota error and the
# app says image generation is unavailable. Changing this needs a redeploy.
GEMINI_IMAGE_MODEL=
